{
  "capture": {
    "cmake_keys": [
      "CMAKE_BUILD_TYPE",
      "CMAKE_CXX_COMPILER",
      "CMAKE_C_COMPILER",
      "CMAKE_CXX_FLAGS",
      "CMAKE_C_FLAGS",
      "CMAKE_CXX_FLAGS_RELEASE",
      "CMAKE_CXX_FLAGS_RELWITHDEBINFO",
      "CMAKE_CXX_STANDARD",
      "CMAKE_INTERPROCEDURAL_OPTIMIZATION",
      "BUILD_SHARED_LIBS"
    ],
    "env_allowlist": [
      "OMP_NUM_THREADS",
      "OMP_PROC_BIND",
      "OMP_PLACES",
      "OMP_SCHEDULE",
      "GOMP_CPU_AFFINITY",
      "KMP_AFFINITY",
      "LD_PRELOAD",
      "LD_LIBRARY_PATH",
      "MALLOC_CONF",
      "TCMALLOC_RELEASE_RATE"
    ]
  },
  "comparators": {
    "build.cmake.CMAKE_CUDA_FLAGS": "flagset",
    "build.cmake.CMAKE_CXX_FLAGS*": "flagset",
    "build.cxx_flags": "flagset",
    "execution.launcher_args": "flagset",
    "hardware.gpu_models": "set",
    "hardware.hostnames": "set",
    "scheduler.submit_dir": "path",
    "source.repo_path": "path"
  },
  "metrics": {},
  "severity": {
    "build.*": "critical",
    "build.cmake_cache_path": "informational",
    "deps.*": "critical",
    "deps.container_image_sha256": "critical",
    "deps.container_runtime": "critical",
    "execution.command": "informational",
    "execution.launcher": "critical",
    "execution.launcher_args": "critical",
    "execution.program": "critical",
    "execution.program_args": "critical",
    "execution.program_sha256": "critical",
    "execution.workdir": "informational",
    "hardware.*": "material",
    "hardware.gpu_vendor": "critical",
    "hardware.hostnames": "informational",
    "hardware.node_count": "material",
    "hardware.os_version": "material",
    "packs.active": "material",
    "parallelism.*": "material",
    "runtime.env.*": "critical",
    "runtime.mpi_*": "material",
    "runtime.transport_configured": "material",
    "scheduler.*": "material",
    "scheduler.job_id": "informational",
    "scheduler.job_name": "informational",
    "scheduler.nodelist": "informational",
    "scheduler.submit_dir": "informational",
    "scheduler.system": "material",
    "source.branch": "informational",
    "source.commit": "critical",
    "source.dirty": "critical",
    "source.repo_path": "informational",
    "source.submodules": "critical",
    "system.*": "material",
    "system.load_1m": "informational",
    "system.mem_available_mb": "informational",
    "toolchain.*": "critical"
  }
}
