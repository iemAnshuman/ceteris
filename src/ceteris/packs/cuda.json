{
  "activate": {
    "env_any": [
      "CUDA_VISIBLE_DEVICES"
    ],
    "path_tools": [
      "nvidia-smi",
      "nvcc"
    ]
  },
  "capture": {
    "cmake_keys": [
      "CMAKE_CUDA_ARCHITECTURES",
      "CMAKE_CUDA_FLAGS"
    ],
    "env_allowlist": [
      "CUDA_VISIBLE_DEVICES",
      "NVIDIA_VISIBLE_DEVICES",
      "CUDA_LAUNCH_BLOCKING",
      "CUBLAS_WORKSPACE_CONFIG",
      "CUDA_DEVICE_MAX_CONNECTIONS",
      "CUDA_MODULE_LOADING",
      "NCCL_ALGO",
      "NCCL_PROTO",
      "NCCL_DEBUG",
      "NCCL_IB_HCA",
      "NCCL_SOCKET_IFNAME",
      "NCCL_P2P_DISABLE",
      "NCCL_NET_GDR_LEVEL",
      "NCCL_MIN_NCHANNELS",
      "NCCL_MAX_NCHANNELS",
      "NCCL_BUFFSIZE",
      "TORCH_CUDNN_V8_API_ENABLED",
      "TORCH_COMPILE_DEBUG",
      "TORCHINDUCTOR_CACHE_DIR",
      "PYTORCH_CUDA_ALLOC_CONF",
      "TORCH_NCCL_BLOCKING_WAIT",
      "TORCH_DISTRIBUTED_DEBUG"
    ]
  },
  "toolchain": {
    "nvcc": [
      "nvcc",
      "--version"
    ]
  }
}
